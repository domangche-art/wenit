<?xml version="1.0" encoding="utf-8"?>
<!--
  15단계 Lv.4 캐릭터 방해. 화면 전체를 반투명 막(lv4_scrim)으로 덮는다. clickable 은 막 위 터치를 아래 앱으로 넘기지 않기 위함이다
  (다음 영상으로 넘기기·영상 탭을 막는다). 홈·뒤로 같은 시스템 탐색은 막지 않는다.

  lv4CharacterSlot 은 캐릭터 자리만 차지하는 빈 뷰다. 캐릭터는 이 자리에 맞춘 별도 창(CharacterOverlay)으로 띄운다.
  등장·퇴장을 창 애니메이션으로 하기 위함이다(14-2단계). 크기는 InterventionPopup 이 화면 너비의 절반으로 정한다.
  처음 그림이 최종 모습이다(투명에서 시작하는 뷰가 없다). 말풍선·남은 횟수 글자의 갱신은 화면 프레임이 와야 보인다.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/lv4_scrim"
    android:clickable="true"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="@dimen/popup_padding">

    <TextView
        android:id="@+id/popupTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:textColor="@color/breathing_text"
        android:textSize="@dimen/lv4_title_text"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/lv4Bubble"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/popup_section_gap"
        android:background="@drawable/bg_lv4_bubble"
        android:gravity="center"
        android:padding="@dimen/lv4_bubble_padding"
        android:textColor="@color/lv4_bubble_text"
        android:textSize="@dimen/lv4_bubble_text"
        android:visibility="gone" />

    <View
        android:id="@+id/lv4CharacterSlot"
        android:layout_width="1dp"
        android:layout_height="1dp"
        android:layout_marginTop="@dimen/popup_option_gap"
        android:importantForAccessibility="no" />

    <TextView
        android:id="@+id/lv4TapsLeft"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/popup_option_gap"
        android:textColor="@color/breathing_text_secondary"
        android:textSize="@dimen/lv4_taps_text" />

    <TextView
        android:id="@+id/popupContinue"
        style="@style/PopupButton.Secondary.Lv4"
        android:layout_marginTop="@dimen/popup_section_gap"
        android:text="@string/popup_lv4_fallback_continue"
        android:visibility="gone" />

    <TextView
        android:id="@+id/popupStop"
        style="@style/PopupButton.Primary.Lv4"
        android:layout_marginTop="@dimen/popup_section_gap"
        android:text="@string/popup_lv4_stop" />

    <TextView
        android:id="@+id/popupAllowance"
        style="@style/PopupButton.Text.OnScrim"
        android:visibility="gone" />
</LinearLayout>
